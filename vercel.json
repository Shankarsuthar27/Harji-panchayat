{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "harji-panchayat": {
      "root": "artifacts/harji-panchayat",
      "framework": "vite",
      "outputDirectory": "dist/public",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "API_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "harji-panchayat"
      }
    }
  ]
}
